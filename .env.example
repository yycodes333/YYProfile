# Public site URL used for canonical metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 公开联系邮箱；联系表单与 mailto 链接都用它
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# 联系表单实际投递的收件地址，留空则使用上面的公开邮箱
CONTACT_TO_EMAIL=

# 方式一：Resend HTTP API（Cloudflare/Edge 环境可用）
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# 方式二：SMTP（Node 运行时可使用，例如 QQ 邮箱 / Gmail 应用专用密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
